# --- Required ---
OPENAI_API_KEY=sk-your-key-here

# --- App ---
APP_NAME=AI Assistant
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# --- API ---
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# --- OpenAI ---
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_S=30
OPENAI_MAX_RETRIES=2

# --- ChromaDB ---
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=documents

# --- Agent ---
AGENT_MAX_STEPS=5
AGENT_MAX_STEPS_HARD_CAP=20

# --- RAG ---
RAG_DEFAULT_TOP_K=3
RAG_MAX_TOP_K=20
